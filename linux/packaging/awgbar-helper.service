[Unit]
Description=AWG Bar VPN helper
Documentation=https://github.com/artemimennoi/awgbar
After=dbus.service network-pre.target
Wants=network-pre.target

[Service]
Type=simple
ExecStart=/usr/lib/awgbar/awgbar-helper
Restart=always
RestartSec=1
# /run/awgbar survives a restart (crash, upgrade) so the helper reconnects the tunnel that was
# up, but not a stop or a reboot.
RuntimeDirectory=awgbar
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=restart
StateDirectory=awgbar
StateDirectoryMode=0700

# Root, but only with the network capabilities it needs. /etc stays writable for resolv.conf
# on systems without systemd-resolved.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=true
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
# ProtectClock closes the device policy; the tunnel needs the TUN clone device.
DeviceAllow=/dev/net/tun rw
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
