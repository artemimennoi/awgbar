+# AWGBar: true when a pinned destination no longer leaves through a physical interface: its
+# route is gone and the tunnel's own routes catch the traffic.
+route_lost() {
+	local family=-inet line iface=""
+	[[ $1 == *:* ]] && family=-inet6
+	while read -r line; do
+		[[ $line == interface:* ]] && iface="${line#interface: }"
+	done < <(route -n get "$family" "$1" 2>/dev/null)
+	[[ -z $iface || $iface == "$REAL_INTERFACE" ]]
+}
